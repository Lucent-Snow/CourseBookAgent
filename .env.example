# === LLM API ===
# 使用你自己的 OpenAI 兼容端点，不要复制他人的地址或 key
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=120
# Optional CNY prices per one million tokens. Leave blank when the provider
# does not expose a stable price or when this is only a usage dashboard.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true

# === Storage ===
DATA_DIR=./data
OUTPUT_DIR=./data/output

# === Zhiyun (or log in through Settings) ===
ZHIYUN_JWT=
ZHIYUN_SESSION_FILE=./data/zhiyun/session.json
XUEZAI_SESSION_FILE=./data/xuezai/session.json
